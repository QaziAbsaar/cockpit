# .env.example
JWT_SECRET=replace-with-a-long-random-string
# HMAC-SHA256 secret shared with OpenWA's webhook registration (16+ chars) — must match the
# `secret` you pass to `POST /api/sessions/:sessionId/webhooks` on the OpenWA side exactly.
WEBHOOK_SECRET=replace-with-a-long-random-string
OPENWA_BASE_URL=http://your-openwa-host:port
# Scoped OpenWA API key for cockpit (operator role, allowedSessions restricted to OPENWA_SESSION_ID)
OPENWA_API_KEY=your-openwa-api-key
# The session UUID OpenWA assigned when the session was created (not the friendly session name)
OPENWA_SESSION_ID=your-openwa-session-uuid
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
VITE_API_URL=http://your-domain-or-ip:4000
VITE_WS_URL=ws://your-domain-or-ip:4000
